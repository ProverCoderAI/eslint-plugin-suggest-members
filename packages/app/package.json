{
  "name": "@effect-template/app",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal Vite-powered TypeScript console starter using Effect",
  "main": "dist/main.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "build": "vite build --ssr src/app/main.ts",
    "dev": "vite build --watch --ssr src/app/main.ts",
    "lint": "vibecode-linter src/",
    "lint:tests": "vibecode-linter tests/",
    "check": "pnpm run typecheck",
    "prestart": "pnpm run build",
    "start": "node dist/main.js",
    "test": "pnpm run lint:tests && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProverCoderAI/eslint-plugin-suggest-members.git"
  },
  "keywords": [
    "effect",
    "typescript",
    "vite",
    "console"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ProverCoderAI/eslint-plugin-suggest-members/issues"
  },
  "homepage": "https://github.com/ProverCoderAI/eslint-plugin-suggest-members#readme",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/cluster": "^0.58.0",
    "@effect/experimental": "^0.60.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "@effect/printer": "^0.49.0",
    "@effect/printer-ansi": "^0.49.0",
    "@effect/rpc": "^0.75.0",
    "@effect/schema": "^0.75.5",
    "@effect/sql": "^0.51.0",
    "@effect/typeclass": "^0.40.0",
    "@effect/workflow": "^0.18.0",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "latest",
    "@effect/vitest": "^0.29.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/compat": "2.0.3",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "^10.0.1",
    "@prover-coder-ai/eslint-plugin-suggest-members": "workspace:*",
    "@ton-ai-core/vibecode-linter": "^1.0.11",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-codegen": "0.34.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "@vitest/eslint-plugin": "^1.6.13",
    "globals": "^17.4.0",
    "jscpd": "^4.0.8",
    "ts-morph": "^27.0.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  }
}
